<Application x:Class="LightPCCleaner.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B0F14"/>
        <SolidColorBrush x:Key="Panel" Color="#111820"/>
        <SolidColorBrush x:Key="Panel2" Color="#151E27"/>
        <SolidColorBrush x:Key="Line" Color="#263340"/>
        <SolidColorBrush x:Key="Text" Color="#F3F7FA"/>
        <SolidColorBrush x:Key="Muted" Color="#8B9AA8"/>
        <SolidColorBrush x:Key="Green" Color="#22C55E"/>
        <SolidColorBrush x:Key="GreenDim" Color="#123521"/>
        <SolidColorBrush x:Key="Blue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="Blue2" Color="#60A5FA"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#18232E"/><Setter Property="BorderBrush" Value="#314150"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
    </Application.Resources>
</Application>
