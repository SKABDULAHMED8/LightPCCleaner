<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <AssemblyName>LightPCCleaner</AssemblyName>
    <RootNamespace>LightPCCleaner</RootNamespace>

    <ApplicationIcon>Assets\LightPCCleaner.ico</ApplicationIcon>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <Product>Light PC Cleaner</Product>
    <Company>LightPCCleaner</Company>
    <Description>Small offline Windows cleaner for safe temporary and application cache cleanup.</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

</Project>